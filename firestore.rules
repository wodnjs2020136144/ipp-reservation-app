rules_version = '2';

// 이 앱은 내부 운영진 전용 도구로, Firebase 익명 인증만 사용합니다.
// 사용자별 소유권 모델이 없으므로 "로그인 여부"가 사실상 유일하게 적용 가능한
// 접근 통제 기준입니다. 아래는 앱이 실제로 사용하는 경로만 최소한으로 열고
// 나머지는 기본 차단하는 최소 권한(default-deny) 규칙입니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 교구 재고/수리 정보 — services/kitService.js
    match /kits/{kitId} {
      allow read, write: if request.auth != null;
    }

    // 교구 변경 이력 — services/kitService.js (logs/kitLogs)
    match /logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // 근무자 스케줄 설정 — services/scheduleService.js (settings/scheduleConfig)
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // 그 외 모든 경로는 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
