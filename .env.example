# 예약 서버 REST API 주소 (선택, 기본값은 fly.io 배포 주소)
EXPO_PUBLIC_API_BASE_URL=https://ipp-reservation-server.fly.dev

# Firebase 프로젝트 설정 (선택, 기본값은 firebase.js에 내장된 ipp-reservation-app 프로젝트 값)
# 다른 Firebase 프로젝트(예: 별도 개발/스테이징 환경)로 연결하려면 아래 값을 채우세요.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
